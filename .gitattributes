# 项目主体跑在 Linux 容器里，强制用 LF，避免 Windows  checkout 后 entrypoint.sh 失效
* text=auto eol=lf

*.sh text eol=lf
Dockerfile text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.txt text eol=lf
LICENSE text eol=lf

# Windows 批处理必须用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做转换
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
